{
  "name": "levantamiento-rq",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:backend": "nx run-many --target=build --projects=gateway,identity-service,projects-service,sources-service,documents-service,ai-analysis-service,erp-knowledge-service,workflow-service,operations-service --parallel=3",
    "build:shared": "nx run-many --target=build --projects=shared-config,shared-contracts,shared-errors,shared-http,shared-observability,shared-testing --parallel=3",
    "build:web": "nx build web",
    "dev:web": "nx dev web",
    "graph": "nx graph",
    "lint:backend": "nx run-many --target=lint --projects=gateway,identity-service,projects-service,sources-service,documents-service,ai-analysis-service,erp-knowledge-service,workflow-service,operations-service --parallel=3",
    "lint:shared": "nx run-many --target=lint --projects=shared-config,shared-contracts,shared-errors,shared-http,shared-observability,shared-testing --parallel=3",
    "serve:gateway": "nx serve gateway",
    "validate:gateway": "nx run gateway:lint && nx run gateway:build",
    "validate:persistence": "nx run-many --target=lint,build --projects=shared-persistence,identity-service,projects-service,sources-service,documents-service,ai-analysis-service,erp-knowledge-service,workflow-service,operations-service",
    "validate:web": "nx run-many --target=lint,build --projects=web,shared-ui",
    "serve:identity": "nx serve identity-service",
    "test:auth": "TSX_TSCONFIG_PATH=apps/identity-service/tsconfig.app.json node --import tsx --test tests/identity/auth-foundation.test.ts",
    "validate:auth": "nx run-many --target=lint,build --projects=identity-service,gateway,web,shared-contracts,shared-ui --parallel=3 && pnpm test:auth",
    "identity:migration:run": "TSX_TSCONFIG_PATH=apps/identity-service/tsconfig.app.json node --import tsx scripts/identity-run-migrations.ts",
    "identity:migration:revert": "TSX_TSCONFIG_PATH=apps/identity-service/tsconfig.app.json node --import tsx scripts/identity-revert-migration.ts",
    "identity:create-user": "TSX_TSCONFIG_PATH=apps/identity-service/tsconfig.app.json node --import tsx scripts/identity-create-user.ts"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/rollup": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "core-js": "^3.36.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "rollup": "^4.14.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1",
    "tsx": "4.20.6",
    "typeorm": "0.3.31"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "^5.11.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
