NODE_ENV=development
SERVICE_NAME=identity-service
HOST=127.0.0.1
PORT=3001

DATABASE_ENABLED=false
DB_HOST=sql.example.local
DB_PORT=1433
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=RqIdentityDb
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGGING=false

AUTH_ENABLED=false
JWT_ISSUER=levantamiento-rq-identity
JWT_AUDIENCE=levantamiento-rq
# JWK privado Ed25519 (solo Identity) y JWKS público, ambos JSON codificados en base64.
JWT_ACCESS_KEY_ID=identity-ed25519-2026-01
JWT_ACCESS_PRIVATE_JWK_BASE64=
JWT_ACCESS_PUBLIC_JWKS_BASE64=
JWT_REFRESH_SECRET=change-me-with-at-least-32-characters-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Acceso con Microsoft Entra ID (opcional). Requiere AUTH_ENABLED=true.
# Registrar la app en Entra ID como "Web" con la URI de redireccionamiento indicada.
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
# Dominios de correo permitidos, separados por coma (vacío = cualquiera del tenant).
MICROSOFT_ALLOWED_EMAIL_DOMAINS=
