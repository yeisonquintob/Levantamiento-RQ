NODE_ENV=development
SERVICE_NAME=ai-analysis-service
HOST=127.0.0.1
PORT=3005
DATABASE_ENABLED=true
DB_HOST=sql.example.local
DB_PORT=1433
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=RqAiDb
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGGING=false
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://change-me:change-me@127.0.0.1:5673
RABBITMQ_EXCHANGE=rq.integration.v1
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
AI_CREATE_DATABASE=false
JWT_ISSUER=levantamiento-rq-identity
JWT_AUDIENCE=levantamiento-rq
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
PROJECTS_SERVICE_URL=http://127.0.0.1:3002
PROJECTS_TIMEOUT_MS=8000
DOCUMENTS_SERVICE_URL=http://127.0.0.1:3004
DOCUMENTS_TIMEOUT_MS=8000
SOURCES_SERVICE_URL=http://127.0.0.1:3003
SOURCES_TIMEOUT_MS=8000
# Las credenciales de proveedores nunca se almacenan en este archivo.
AI_SECRET_VAULT=MACOS_KEYCHAIN
AI_KEYCHAIN_SERVICE=com.navitrans.levantamiento-rq.ai
AI_EXECUTION_MODE=OPENAI
AI_PROCESSING_QUEUE=ai-analysis-processing
AI_REDIS_HOST=127.0.0.1
AI_REDIS_PORT=6381
AI_PROCESSING_ATTEMPTS=3
AI_PROCESSING_BACKOFF_MS=2000
AI_PROCESSING_CONCURRENCY=1
