NODE_ENV=development
SERVICE_NAME=ai-analysis-service
HOST=127.0.0.1
PORT=3005
DATABASE_ENABLED=true
DB_HOST=sql.example.local
DB_PORT=1433
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=RqAiDb
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGGING=false
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://change-me:change-me@127.0.0.1:5673
RABBITMQ_EXCHANGE=rq.integration.v1
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
AI_CREATE_DATABASE=false
JWT_ISSUER=levantamiento-rq-identity
JWT_AUDIENCE=levantamiento-rq
JWT_ACCESS_PUBLIC_JWKS_BASE64=
WORKLOAD_JWT_KEY_ID=ai-analysis-ed25519-2026-01
WORKLOAD_JWT_PRIVATE_JWK_BASE64=
PROJECTS_SERVICE_URL=http://127.0.0.1:3002
PROJECTS_TIMEOUT_MS=8000
DOCUMENTS_SERVICE_URL=http://127.0.0.1:3004
DOCUMENTS_TIMEOUT_MS=8000
SOURCES_SERVICE_URL=http://127.0.0.1:3003
SOURCES_TIMEOUT_MS=8000
# Las credenciales de proveedores nunca se almacenan en este archivo.
AI_SECRET_VAULT=MACOS_KEYCHAIN
AI_KEYCHAIN_SERVICE=com.navitrans.levantamiento-rq.ai
# Producción: AI_SECRET_VAULT=AZURE_KEY_VAULT y URL oficial del vault.
# AI_KEY_VAULT_URL=https://<vault>.vault.azure.net
AI_EXECUTION_MODE=OPENAI
AI_PROCESSING_QUEUE=ai-analysis-processing
AI_REDIS_HOST=127.0.0.1
AI_REDIS_PORT=6381
AI_PROCESSING_ATTEMPTS=3
AI_PROCESSING_BACKOFF_MS=2000
AI_PROCESSING_CONCURRENCY=1
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama en otro equipo de la red local: autoriza su IP de forma explícita y apunta
# OLLAMA_BASE_URL a ella (p. ej. http://192.168.1.50:11434). Solo IPv4 privadas o
# nombres .local. En ese equipo: OLLAMA_HOST=0.0.0.0:11434. El tráfico va por HTTP
# sin cifrar dentro de la LAN.
# LOCAL_AI_ALLOWED_HOSTS=192.168.1.50
OLLAMA_MODEL=gemma4:12b
LOCAL_AI_MAX_CONCURRENT_JOBS=1
LOCAL_AI_TIMEOUT_MS=600000
LOCAL_AI_CONTEXT_TOKENS=131072
LOCAL_AI_FALLBACK_TO_RAW_SOURCES=false
LOCAL_AI_MAX_RESPONSE_BYTES=2097152
# Solo para procesos dentro de Docker local, nunca habilitar implícitamente.
LOCAL_AI_ALLOW_DOCKER_HOST=false
# BLOCK impide cualquier salida con secretos detectados; REDACT permite enviarla saneada.
AI_DLP_POLICY=BLOCK
PROTOTYPE_IMAGE_MODEL=gpt-image-2.5-flare
PROTOTYPE_IMAGE_QUALITY=medium
PROTOTYPE_IMAGE_TIMEOUT_MS=600000
PROTOTYPE_IMAGE_MAX_BASE64_CHARS=30000000
AI_QUOTA_USER_REQUESTS_HOUR=5
AI_QUOTA_USER_REQUESTS_DAY=20
AI_QUOTA_PROJECT_REQUESTS_HOUR=10
AI_QUOTA_PROJECT_REQUESTS_DAY=50
AI_QUOTA_GLOBAL_REQUESTS_HOUR=50
AI_QUOTA_GLOBAL_REQUESTS_DAY=200
AI_QUOTA_USER_TOKENS_DAY=500000
AI_QUOTA_PROJECT_TOKENS_DAY=2000000
AI_QUOTA_GLOBAL_TOKENS_DAY=10000000
AI_QUOTA_USER_CONCURRENT=1
AI_QUOTA_PROJECT_CONCURRENT=2
AI_QUOTA_GLOBAL_CONCURRENT=4
AI_BUDGET_DAILY_USD=50
AI_BUDGET_MONTHLY_USD=500
