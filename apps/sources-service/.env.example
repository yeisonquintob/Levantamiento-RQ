NODE_ENV=development
SERVICE_NAME=sources-service
HOST=127.0.0.1
PORT=3003
DATABASE_ENABLED=true
DB_HOST=sql.example.local
DB_PORT=1433
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=RqSourcesDb
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGGING=false
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://change-me:change-me@127.0.0.1:5673
RABBITMQ_EXCHANGE=rq.integration.v1
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
JWT_ISSUER=levantamiento-rq-identity
JWT_AUDIENCE=levantamiento-rq
JWT_ACCESS_PUBLIC_JWKS_BASE64=
PROJECTS_SERVICE_URL=http://127.0.0.1:3002
PROJECTS_TIMEOUT_MS=8000
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=change-me;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
SOURCES_STORAGE_CONTAINER=rq-sources
SOURCES_MAX_FILE_BYTES=20971520
SOURCES_MAX_FILES_PER_UPLOAD=20
SOURCES_MAX_BATCH_BYTES=104857600
SOURCES_MAX_EXTRACTED_TEXT_CHARS=2000000
SOURCES_PARSER_TIMEOUT_MS=60000
SOURCES_MAX_PDF_PAGES=500
SOURCES_MAX_XLSX_SHEETS=50
SOURCES_MAX_XLSX_ROWS=100000
SOURCES_MAX_XLSX_COLUMNS=1000
SOURCES_MAX_XLSX_CELLS=1000000
SOURCES_ANTIMALWARE_MODE=MOCK
# Producción: HTTP, HTTPS y host incluido explícitamente en la allowlist.
SOURCES_ANTIMALWARE_ENDPOINT=
SOURCES_ANTIMALWARE_ALLOWED_HOSTS=
SOURCES_ANTIMALWARE_BEARER_TOKEN=
SOURCES_ANTIMALWARE_TIMEOUT_MS=30000
SOURCES_REDIS_HOST=127.0.0.1
SOURCES_REDIS_PORT=6381
SOURCES_REDIS_PASSWORD=change-me
SOURCES_PROCESSING_QUEUE=source-processing
SOURCES_PROCESSING_ATTEMPTS=3
SOURCES_PROCESSING_BACKOFF_MS=1000
SOURCES_PROCESSING_CONCURRENCY=2
